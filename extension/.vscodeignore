# Source TypeScript — compiled output in dist/ is what runs
src/
mcp-server/
tsconfig.json

# node_modules — MCP server is bundled via esbuild into dist/mcp-server/server.js
# js-yaml is kept because the orchestrator requires it at runtime
node_modules/
!node_modules/js-yaml
!node_modules/js-yaml/**
!node_modules/argparse
!node_modules/argparse/**

# Test infrastructure
**/*.test.js
**/*.spec.js
jest.config.*

# Packaging artefacts — don't bundle old VSIXes inside the new one
*.vsix

# Dev tooling
.vscode/
.eslintrc*
.prettierrc*
