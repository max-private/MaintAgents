# Source TypeScript — compiled output in dist/ is what runs
src/
tsconfig.json

# node_modules — js-yaml is kept because the orchestrator requires it at runtime
# mcp-server is a Python script (server.py) and is included in the VSIX as-is
node_modules/
!node_modules/js-yaml
!node_modules/js-yaml/**
!node_modules/argparse
!node_modules/argparse/**

# Test infrastructure
**/*.test.js
**/*.spec.js
jest.config.*

# Packaging artefacts — don't bundle old VSIXes inside the new one
*.vsix

# Dev tooling
.vscode/
.eslintrc*
.prettierrc*
