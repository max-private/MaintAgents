{
  "name": "maintenance-agents",
  "displayName": "Maintenance Agents",
  "description": "Specialized maintenance agents for Java, .NET, Python, Perl, Eclipse RCP, web services, OS compatibility, security vulnerabilities, test fixes, and code quality",
  "version": "1.4.2",
  "publisher": "MaintenanceAgents",
  "license": "MIT",
  "author": {
    "name": "Maintenance Agents Team"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maintenanceagents/maintenance-agents"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "dist/extension/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Developer Tools",
    "Linters"
  ],
  "galleryBanner": {
    "color": "#f0ad4e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "MaintenanceAgents.maintenance",
        "name": "maintenance",
        "fullName": "Maintenance Agents",
        "description": "Specialized agents for Java, .NET, Python, and Perl maintenance, Eclipse RCP, web services, OS compatibility, vulnerability fixes, test fixes, and code quality",
        "isAgent": true,
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Fix code issues and bugs"
          },
          {
            "name": "analyze",
            "description": "Analyze code for issues"
          },
          {
            "name": "upgrade",
            "description": "Upgrade code to newer versions"
          },
          {
            "name": "security",
            "description": "Check for security vulnerabilities"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.7.1",
    "jest": "^30.3.0",
    "typescript": "^5.3.0",
    "vscode-test": "^1.6.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
