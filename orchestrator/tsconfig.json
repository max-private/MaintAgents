{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": ".",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "typeRoots": ["../extension/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "js-yaml": ["./js-yaml.d.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
